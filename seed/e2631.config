# Seed .config for the E2631 build. Intentionally minimal on the first run:
# LuCI and the Wi-Fi stack are commented out so a green baseline comes back
# quickly, then get added one at a time.
CONFIG_TARGET_sanechips=y
CONFIG_TARGET_sanechips_generic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_sanechips_generic_DEVICE_zte_zxhn-e2631=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y

CONFIG_PACKAGE_e2631-fwslot=y

# Debug and console helpers, cheap and needed while the port is untested.
CONFIG_PACKAGE_minicom=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y

# The sanechips target has no fpu in FEATURES, so OpenWrt selects soft-float by
# default and this SoC (no VFP at all) needs it: hard-float binaries would build
# fine and then die with SIGILL on the device. Asserted in CI, spelled out here.
CONFIG_SOFT_FLOAT=y

CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_COLLECT_KERNEL_DEBUG=y

# /dev/mem has to be asked for as a CONFIG_KERNEL_* line, not as a kernel
# fragment: include/kernel-defaults.mk appends every CONFIG_KERNEL_X of this
# top-level .config to the merged kernel config with the prefix stripped, and
# the kconfig merge is last-wins. config/Config-kernel.in declares KERNEL_DEVMEM
# with default n, so the passthrough carried "# CONFIG_DEVMEM is not set" after
# the fragments' =y and won. That is the whole of known-issues DEVMEM-DROPPED
# (mechanism found upstream, d68e3b7); without it /sbin/e2631-fwstate and the
# regprobe tool have no /dev/mem to read.
CONFIG_KERNEL_DEVMEM=y

# The web UI iteration (2026-10-13, local WSL build): LuCI with the Chinese base
# translation, a web terminal for debugging, and pppoe in case the uplink ever
# needs it. DEVICE_PACKAGES in Makefile.e2631 is what actually pulls these in;
# they are spelled out here so the seed documents the image.
CONFIG_PACKAGE_luci=y
# v1.3: build the zh_Hans translation for EVERY LuCI app in the image
# (zte-mesh, argon-config, ...), not just luci-base
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
# v1.3: Argon (the default since v1.0) is now VENDORED at
# overlay/package/luci/luci-theme-argon - same theme, no GitHub clone at
# apply time. Its uci-defaults claims main.mediaurlbase before Bootstrap's,
# which only writes the option when still unset, so Argon stays the default.
# Bootstrap remains selected as the fallback.
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
# v1.3: https for the online updater (api.github.com)
CONFIG_PACKAGE_libustream-mbedtls=y
# v1.3: firewall flow offloading. kmod-nf-flow was already pulled in by
# fstools, but the nft flowtable statement (what fw4 actually compiles the
# flowtable rule into) needs this package; without it "flow_offloading 1" in
# the firewall config would be a no-op. The PPE hardware path is in the gmac
# driver already.
CONFIG_PACKAGE_kmod-nft-offload=y
# v1.5: the PPE engine itself (classifier tables, hash banks, rewrite tables) as
# a module instead of part of the built-in gmac driver, so a change there
# rebuilds one .ko instead of the kernel. It is in DEVICE_PACKAGES too, but that
# list only reaches .config when tmp/.targetinfo is regenerated, and
# image/Makefile.e2631 is not among the files that make it stale (include/scan.mk
# watches image/Makefile and image/*.mk; this file is neither). Selecting it here
# is what actually decides it, exactly like kmod-mt7916-firmware above.
CONFIG_PACKAGE_kmod-e2631-ppe=y
# v1.3: userdata extroot tooling (ubiformat/ubiattach/ubimkvol/ubiupdatevol
# and the block-mount machinery fstab runs through).
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_block-mount=y
# v1.3: the ZTE mesh controller (vendored from cnjn/zte-mesh, sandboxed
# vendor multiapd, master role only; ships disabled).
CONFIG_PACKAGE_zte-mesh=y
CONFIG_PACKAGE_luci-app-zte-mesh=y
# v1.3: the E2631 board page (slot table, update check, switch back to stock)
CONFIG_PACKAGE_luci-app-e2631=y
# v1.4: WAN/LAN adaptive - any wired port can be the WAN (the factory's
# "WAN/LAN 自适应"). The service itself is in the target's base-files; this is
# only its LuCI page.
CONFIG_PACKAGE_luci-app-e2631-wanport=y
# Its Simplified Chinese strings. luci.mk strips the luci-app- prefix when it
# names the translation package (tmp/.config-package.in: PACKAGE_luci-i18n-
# e2631-wanport-zh-cn), and the po directory zh_Hans maps to the -zh-cn suffix
# through LUCI_LC_ALIAS. Without this the page stays English.
CONFIG_PACKAGE_luci-i18n-e2631-wanport-zh-cn=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-proto-ppp=y
# CONFIG_PACKAGE_luci-ssl-openssl=y  stays off on purpose: dropbear already
# gives an encrypted shell, and a self-signed https on the LAN buys nothing here.
# CONFIG_PACKAGE_kmod-mt7915e=y  (in DEVICE_PACKAGES since run 4)
# CONFIG_PACKAGE_kmod-mt7915-firmware=y
# kmod-mt7915e drags kmod-mt7915-firmware in through DEPENDS, but the MT7916
# firmware is an optional sibling: naming it in DEVICE_PACKAGES alone left
# "# CONFIG_PACKAGE_kmod-mt7916-firmware is not set" in .config and the image
# shipped only mt7915_*.bin. It has to be selected here.
CONFIG_PACKAGE_kmod-mt7916-firmware=y

# Wireless stack: the FULL wpad variant, selected explicitly. Nothing in this
# tree ever asked for wpad-basic-mbedtls - it is the target's DEFAULT variant,
# silently chosen - and it has no 802.11r/k/v, no mesh and no WPA3-SAE, which
# no uci option can add afterwards. The regulatory database is what makes 5 GHz
# channel/power/DFS follow the CN view instead of the driver's built-in
# regdomain. (Both adopted from upstream v1.8.0, f41432e.)
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_wireless-regdb=y
# CONFIG_PACKAGE_kmod-usb3 is deliberately never enabled: this board has no
# usable USB and probing the controller reboots it.

# 追加（本地改动）：relayd 伪桥 + LuCI 协议页，用于 WLAN 客户端中继。
# relayd 的包定义在基线树 package/network/services/relayd，不在任何 feed 里；
# luci-proto-relay 在 luci feed 的 protocols/ 下，DEPENDS 是 +relayd，所以选它
# 会顺带把 relayd 拉进来。两个都显式写上，方便日后核对到底装了什么。
CONFIG_PACKAGE_relayd=y
CONFIG_PACKAGE_luci-proto-relay=y
