#!/bin/sh /etc/rc.common
# Dual-core load spreading for the gmac ports, applied every boot (sysfs
# does not persist).  Four independent knobs, each with its evidence:
#
#  RPS on CPU0 with the IRQ on CPU1 - one RX ring shares one IRQ line for
#    every port, so the driver's NAPI always runs on the IRQ's core.  Leaving
#    the protocol stack on the *other* core is what keeps a single core from
#    carrying both halves.  History: the original tuning put the IRQ on CPU0
#    and RPS on CPU1 (a split) and measured +4.6 %; a later change pinned the
#    IRQ to CPU1 as well ("keep the softirq local to the IRQ"), which put both
#    halves back on one core and was never re-measured on a CPU-bound path.
#    Measured 2026-10-30 on routed IPv6 with software flow offload (the only
#    v6 fast path this board has), 8 TCP streams x 15 s, several runs each:
#       IRQ CPU1 + RPS CPU1 (both halves on one core)
#                                    341-374 Mbit/s, CPU1 sirq 81-89 %
#       IRQ CPU1 + RPS CPU0 (split)  392-410 Mbit/s, CPU1 sirq 72-77 %,
#                                    CPU0 32-34 %
#    i.e. +12 % and neither core permanently pegged.  On the IPv4 PPE path
#    the data plane bypasses the CPU entirely, so this knob does not matter
#    there.  XPS is not touched: the single TX queue's xps_cpus exists in
#    sysfs but reads ENOENT here, so the old XPS=CPU1 write was a no-op.
#
#  IRQ affinity of 92000000.ethernet to CPU1 - the complement of the above.
#    Pinning the IRQ alone, with RPS still on the same core, measured no gain:
#    what matters is that the two halves sit on different cores.
#
#  PAUSE frames off - the sibling ZX279133 port (cnjn, right.com.cn
#    thread-8486503) traced a hard upload ceiling to flow-control frames
#    from the switch; their stock kernel had them off on WAN only, ours has
#    them on everywhere.  Disabling the advertisement costs one renegotiation
#    at boot and removes a known failure mode of this PHY family.
#
#  GRO on - the driver already feeds napi_gro_receive(); this only makes the
#    intent explicit and survives any future default change.
START=20
# No USE_PROCD line: rc.common tests [ -n "$USE_PROCD" ], so "USE_PROCD=0" is
# not "off" - it takes the procd branch and the plain start() below then never
# runs, which is how this tuning silently did nothing. Upstream found the same
# in its userdata scripts (42daef9); the fix is to leave the variable unset.

PORTS="lan1 lan2 lan3 wan"

tune_port() {
	local ifn=$1
	[ -d "/sys/class/net/$ifn" ] || return 0
	for q in "/sys/class/net/$ifn/queues/rx-"*; do
		[ -d "$q" ] || continue
		echo 1 > "$q/rps_cpus" 2>/dev/null
		echo 256 > "$q/rps_flow_cnt" 2>/dev/null
	done
	if command -v ethtool >/dev/null 2>&1; then
		ethtool -A "$ifn" rx off tx off 2>/dev/null
		ethtool -K "$ifn" gro on 2>/dev/null
	fi
}

start() {
	# RPS needs the flow table steering entries to have a home
	[ -w /proc/sys/net/core/rps_sock_flow_entries ] && \
		echo 1024 > /proc/sys/net/core/rps_sock_flow_entries 2>/dev/null

	for p in $PORTS; do tune_port "$p"; done

	# the gmac IRQ, by name, wherever it landed
	irq=$(grep -m1 '92000000.ethernet' /proc/interrupts 2>/dev/null | sed 's/:.*//;s/^ *//')
	if [ -n "$irq" ] && [ -w "/proc/irq/$irq/smp_affinity" ]; then
		echo 2 > "/proc/irq/$irq/smp_affinity" 2>/dev/null
	fi
}
