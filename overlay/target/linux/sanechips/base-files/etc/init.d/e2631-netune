#!/bin/sh /etc/rc.common
# Per-core network tuning for the gmac ports, applied every boot (sysfs does
# not persist).  Two knobs are left, each with its evidence:
#
#  IRQ affinity of 92000000.ethernet to CPU1 - one RX ring shares one IRQ line
#    for every port, so the gmac interrupt, and the NAPI it schedules, are
#    handled on CPU1.  This is the only per-core placement this script still
#    makes.
#
#  RPS is deliberately not set here any more, for two reasons:
#    - On the FFE path it cannot apply: an accelerated frame is forwarded
#      inside the driver's poll and never reaches netif_receive_skb(), and
#      get_rps_cpu() is called only from there (net/core/dev.c).  On the IPv4
#      PPE path the data plane bypasses the CPU entirely.
#    - On the stack path the same sysfs files are already rewritten for us:
#      netifd's packet_steering (S25packet_steering) runs 1 s after every
#      interface event and on a firewall reload, and /sbin/e2631-netune-apply
#      runs every minute from cron.  A third writer at boot changed nothing
#      and made this script look like it tuned the fast path.
#    The old "+12 %: IRQ CPU1 + RPS CPU0" numbers were a stack-path (IPv6
#    software offload) measurement and live in
#    docs/features/v6-software-fastpath.md §5.  If packet_steering is ever
#    turned off, set the mask in exactly ONE place - not here plus two
#    backstops.
#
#  PAUSE frames off - the sibling ZX279133 port (cnjn, right.com.cn
#    thread-8486503) traced a hard upload ceiling to flow-control frames
#    from the switch; their stock kernel had them off on WAN only, ours has
#    them on everywhere.  Disabling the advertisement costs one renegotiation
#    at boot and removes a known failure mode of this PHY family.
#
# This script no longer touches the GRO bit, and it no longer touches
# zerocopy at all.  Both now belong to the driver's acceleration-path
# framework (zx279128s-accel.c, P0):
#   - zerocopy is a per-protocol-family mode now ("zc" next to stack/ffe/hw),
#     chosen with the driver's own debugfs knobs accel_ipv4 / accel_ipv6
#     under /sys/kernel/debug/92000000.ethernet/.  The framework is the only
#     writer of that state: it calls zx_zc_set() on the way in and out of the
#     zc mode, keeps the per-family bookkeeping and the PPE mutual exclusion.
#     A boot-time write of the old boolean knob behind the framework's back
#     left accel_ipv4=hw while zc was on - two owners of one state, and the
#     hw/zc exclusion broken.  The uci setting that fed that write
#     (e2631.fastpath.zerocopy) is therefore deprecated and ignored; the
#     defaults are accel_ipv4=hw, accel_ipv6=stack, zc off.
#   - the GRO bit follows the zc mode inside the driver: it is cleared on the
#     way into zc and restored on the way out (zx_eth_open() and zx_zc_set()
#     are the only writers).  Reason is on the TX side, not bp accounting:
#     merged aggregates must be segmented for a 1500 B frame and this driver
#     has no SG/TSO, so segment 2..N are memcpy'd - measured 15.2 -> 28.7 us
#     of sirq per packet and UDP 900M loss 0.95 -> 22 % with GRO on
#     (docs/ffe-zero-copy-2026-10-30.md §6.6).  This script used to set the
#     bit with ethtool -K; it no longer does, because on this kernel
#     `ethtool -K gro off` with GRO outside hw_features goes through
#     wanted_features and measured up leaving the bit *on* ("on [fixed]").
START=20
# No USE_PROCD line: rc.common tests [ -n "$USE_PROCD" ], so "USE_PROCD=0" is
# not "off" - it takes the procd branch and the plain start() below then never
# runs, which is how this tuning silently did nothing. Upstream found the same
# in its userdata scripts (42daef9); the fix is to leave the variable unset.

PORTS="lan1 lan2 lan3 wan"

tune_port() {
	local ifn=$1
	[ -d "/sys/class/net/$ifn" ] || return 0
	for q in "/sys/class/net/$ifn/queues/rx-"*; do
		[ -d "$q" ] || continue
		echo 256 > "$q/rps_flow_cnt" 2>/dev/null
	done
	# 注意：本机驱动没有 set_pauseparam（见 zx279128s-main.c 的 ethtool_ops），这两行是 no-op，别以为 pause 被关了
	command -v ethtool >/dev/null 2>&1 && \
		ethtool -A "$ifn" rx off tx off 2>/dev/null
}

start() {
	# RPS needs the flow table steering entries to have a home
	[ -w /proc/sys/net/core/rps_sock_flow_entries ] && \
		echo 1024 > /proc/sys/net/core/rps_sock_flow_entries 2>/dev/null

	for p in $PORTS; do tune_port "$p"; done

	# the gmac IRQ, by name, wherever it landed
	irq=$(grep -m1 '92000000.ethernet' /proc/interrupts 2>/dev/null | sed 's/:.*//;s/^ *//')
	if [ -n "$irq" ] && [ -w "/proc/irq/$irq/smp_affinity" ]; then
		echo 2 > "/proc/irq/$irq/smp_affinity" 2>/dev/null
	fi
}

# Kept for anyone who calls "/etc/init.d/e2631-netune reload" by hand:
# re-applying the queue tuning is all this does now (the zc apply step that
# used to live here was removed, see the header).
reload() {
	start
}
