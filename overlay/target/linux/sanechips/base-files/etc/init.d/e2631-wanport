#!/bin/sh /etc/rc.common
# 开机跑一次 WAN/LAN 口自适应（原厂的 NetAdapt 是在 cspd 里常驻的；这块板子
# 只在上电、以及 lan/wan 接口上下线时各跑一次就够，没必要留常驻进程）。
#
# START=98：等 network(20)/wifi(95) 都起来之后再做，否则探测时 br-lan 可能还没
# 建好；START 同时就是 rc.common 自动启用的依据（见 apply.sh 的说明）。
START=98
USE_PROCD=0

start() {
	/sbin/e2631-wanport autostart >/dev/null 2>&1 &
}

stop() { :; }

# service reload / ubus network reload 之后重新判定一次
reload() {
	/sbin/e2631-wanport auto >/dev/null 2>&1 &
}
