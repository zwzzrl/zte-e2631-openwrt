#!/bin/sh /etc/rc.common
# Load the packet-processor engine late, and only if the last attempt survived.
#
# Why not /etc/modules.d (2026-10-29): kmodloader runs from /etc/init.d/boot, long
# before the network exists.  An image whose engine module was autoloaded there
# never came up - link up at 1000M, zero ARP replies, no ssh, nothing in the
# network, and since cspboot only ever picks the highest serial the box kept
# booting into the same dead state.  Recovery needed a serial cable.
#
# The guard is the same idea that already keeps a bad Wi-Fi bring-up from
# bricking the box: a pending marker in the overlay survives reboots, so a boot
# that finds the marker still set knows the previous load never confirmed and
# skips the engine for that boot.  The marker is cleared by the loader only after
# the box has stayed up and the stage-2 callback has run; a hang leaves it set.
START=99
USE_PROCD=1

start_service() {
	if [ -e /etc/e2631-ppe-noautoload ]; then
		echo "e2631-ppe: disabled by /etc/e2631-ppe-noautoload" > /dev/kmsg
		return 0
	fi
	procd_open_instance ppe-boot
	procd_set_param command /sbin/e2631-ppe-boot "${DEFER:-20}"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 0
	procd_close_instance
}
