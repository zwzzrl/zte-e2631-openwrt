# WAN/LAN 口自适应（原厂叫「WAN/LAN 自适应」，见
# docs/wanlan-adaptive-逆向记录-2026-10-27.md）
#
# 这块板子的四个物理口是四个独立的 netdev（lan1 lan2 lan3 wan），谁当 WAN
# 只需要把 wan 接口绑到哪个 netdev 上，不需要动交换芯片。所以这里只放策略：
#
#   mode auto    盲插：谁插了上行线、探测到 DHCP 应答，谁就当 WAN（默认）
#   mode manual  手动：固定用 manual_port 指定的那个口
#
# 探测方式与限界：只在候选口上作一次 DHCP DISCOVER（原厂 cspd 的
# NetAdaptStartEthProbe 也是先探测再定角色）。所以「上行为 PPPoE / 静态地址、
# 对端不应答 DHCP」的场景探测不到——那种情况用 manual 模式，或者打开
# assume_single_link 让它按「只插了一根线」来猜。

config ports 'global'
	option enabled '1'

	# auto：盲插自动识别；manual：固定 manual_port
	option mode 'auto'

	# manual 模式下用哪个口当 WAN（lan1/lan2/lan3/wan 之一）
	option manual_port 'wan'

	# 每个候选口的探测超时（秒）。4 个口全探测最坏情况 4×这个值
	option probe_timeout '3'

	# 1 = 探测全失败时，如果只有一根网线插着且不是原来的 WAN 口，就认它当 WAN。
	# 这是给 PPPoE / 静态上行用的兜底猜测，默认关：开了以后「WAN 没插线、只在
	# LAN 口插了一台电脑」会被误判成上行。
	option assume_single_link '0'

	# 参与自适应的物理口（面板从左到右的正反关系见 DTS label）
	list candidates 'lan1' 'lan2' 'lan3' 'wan'
