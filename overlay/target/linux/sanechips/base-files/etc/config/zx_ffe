# RX 中断合并窗口 / NAPI 权重（IPv6 快路调优，2026-11-04）
#
# 这三个值在开机时由 /etc/init.d/zx_ffe_coalesce 写进驱动的 sysfs 参数，写进去
# 立刻生效（不需要 disable/enable）。**内核不读这个文件**：驱动只提供
# module_param 写入口，配置一律由 init 脚本在用户态应用。
#
#   /sys/module/zx279128s_eth/parameters/zxcoal_us      合并时间阈值（µs）
#   /sys/module/zx279128s_eth/parameters/zxcoal_frames  合并帧数阈值（帧）
#   /sys/module/zx279128s_eth/parameters/zxnapi_weight  NAPI 每轮帧数上限
#
# 默认值就是本板实测最优（单流 924.4 Mbit/s，1 GbE 线速 941.5）：250 / 16 / 64。
# 驱动编译期默认值（zx279128s-eth.h 的 ZX_RX_IRQ_USECS / ZX_RX_IRQ_FRAMES）与这里
# 一致，所以"删掉某个 option"或"整份文件缺失"都只是保持驱动当前值：脚本不写。
#
# 合法性（= 驱动范围，或比驱动更严）：us 1..1000000（驱动 0..1000000，main.c:1032）、
# frames 1..4096（驱动 0..4096，main.c:1057）、weight 1..1024（驱动 1..1024，与驱动
# 完全相同，main.c:1104）。超出范围或不是十进制整数时脚本不写，并往 syslog 记一行
# 错误（logger -t zx_ffe_coalesce）。
#
# 改完不用重启：把新值写进这里，然后 /etc/init.d/zx_ffe_coalesce reload。
# （/sbin/reload_config 会经 procd 的 config.change 触发器调用同一条 reload。）

config settings 'settings'
	option rx_coalesce_us '250'
	option rx_coalesce_frames '16'
	option napi_weight '64'
	# 1b-A 子环拆分：1 = 开机把 block1（base 0x100 = lan2 入向）的 128 个 CLA
	# trap 写成 qid=1，并让 rx_split=1 多建一条只扫 ring1 的 NAPI；0 = 关（默认）。
	# 由 /etc/init.d/e2631-rxsplit 应用；优先级：sysfs rx_split 的实际状态 >
	# 本项（只在 sysfs 为 N 时把它打开）。默认 0 时脚本一个字节都不写。
	# 驱动开关本身是 /sys/module/zx279128s_eth/parameters/rx_split（Y/N）。
	# 回退顺序：先 /etc/init.d/e2631-rxsplit stop（写 0+读回），再关 rx_split。
	option rx_split '0'

# 多 WAN / 策略路由安全阀（/etc/init.d/zx_ffe_multiwan + sbin/e2631-ffe-multiwan）
#
# FFE 硬件条目没有"这条 WAN 还活着"的概念；多 WAN 切路由后旧条目仍按旧出口
# 转发 ⇒ 流量静默黑洞，要等老化（默认 300 s）。守卫检测到多 WAN/策略路由就写
# debugfs accel_ipvN=stack 退回纯软件转发；单 WAN 基线下它一次 accel_* 都不写。
# 判据、恢复与绕过：docs/operations/multiwan-ffe-safety.md
#
#   enabled        1 = 守卫生效（默认）；0 = 关守卫，并把之前关掉的快路写回去
#   families       要守的协议族，空格分隔：6 = IPv6 FFE（交付态 accel_v6=ffe）
#                  4 = IPv4 ffe/zc；IPv4 的 PPE 硬件 offload 不归这个开关管，
#                  要关它请用 uci firewall.@defaults[0].flow_offloading_hw=0
#   poll_interval  没有 ifup 时的兜底重评周期，秒（1..60，默认 5）
#   hold_seconds   判据全不成立后再等多久才恢复（默认 300，给 failover/failback
#                  留窗口；0 = 立刻恢复）
config multiwan 'multiwan'
	option enabled '1'
	option families '6'
	option poll_interval '5'
	option hold_seconds '300'
