#!/bin/sh
# Re-apply the queue tuning; this is the last writer against the driver/fw4
# resets that rewrite rps_cpus around link events. Since 2026-10-30 the value
# written here is the driver default (CPU0), so the re-apply is belt and
# braces for the extra knobs rather than a fight with fw4 - see
# /etc/init.d/e2631-netune for the measurements. Called from the iface
# hotplug (fast path) and every minute from cron (backstop).
for ifn in lan1 lan2 lan3 wan; do
	[ -d "/sys/class/net/$ifn" ] || continue
	for q in /sys/class/net/$ifn/queues/rx-*; do
		[ -d "$q" ] || continue
		echo 1 > "$q/rps_cpus" 2>/dev/null
		echo 256 > "$q/rps_flow_cnt" 2>/dev/null
	done
done
